# ==============================================================================
# RR Metal Roofing — Quotation Module
# Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local and populate with your Firebase Web App credentials.
# Values are available in Firebase Console:
# Project Settings > General > Your apps > Web app (rr-metal-roofing-web)
# ==============================================================================

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
